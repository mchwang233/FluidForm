{
  "id": "feishu-bot",
  "name": "飞书机器人",
  "kind": "automation",
  "version": "1.0.0",
  "summary": "在飞书里私聊它，或在群里 @ 它：问题直接回答；要动手的事在搭子里排好计划，主人确认后才开工，做完把结果发回飞书。",
  "usage": "由搭子在后台运行：python bot.py",
  "entry": "python bot.py",
  "check": "python bot.py --check",
  "secrets": ["FEISHU_APP_ID", "FEISHU_APP_SECRET"],
  "domains": ["*.feishu.cn", "*.larksuite.com"]
}
