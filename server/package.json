{
  "name": "fluidform-server",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fluidform": "dist/src/cli.js",
    "super-partner": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node entry.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --import ./tests/helpers/tmp.ts --test \"tests/**/*.test.ts\"",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
